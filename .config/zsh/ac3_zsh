# Set an agent skill on the local data proxy.
setAgentSkills() {
    echo "Enter skillName: " 
    read name
    echo "Enter skillId: " 
    read id
    command="curl -k --location --request POST 'https://${AC3_RC_HOST:-localhost}:32323/set-agent-skill' \
        --header 'Accept: application/json' \
        --header 'Content-Type: application/x-www-form-urlencoded' \
        --data-urlencode 'skillName="${name}"' \
        --data-urlencode 'skillId="${id}"'"
    echo "$command"; eval "$command"
}

setBlendedSkills(){
        #   | HBS           | 30378241 |
        #   | LuxuryStores  | 32591571 |
        #   | PrimeWardrobe | 48781    |
        hbs="curl -k --location --request POST 'https://${AC3_RC_HOST:-localhost}:32323/set-agent-skill' \
        --header 'Accept: application/json' \
        --header 'Content-Type: application/x-www-form-urlencoded' \
        --data-urlencode 'skillName=HBS' \
        --data-urlencode 'skillId=Id=HBS_CA'"
        tbyb="curl -k --location --request POST 'https://${AC3_RC_HOST:-localhost}:32323/set-agent-skill' \
        --header 'Accept: application/json' \
        --header 'Content-Type: application/x-www-form-urlencoded' \
        --data-urlencode 'skillName=TBYB' \
        --data-urlencode 'skillId=Id=PrimeWardrobe'"
        lux="curl -k --location --request POST 'https://${AC3_RC_HOST:-localhost}:32323/set-agent-skill' \
        --header 'Accept: application/json' \
        --header 'Content-Type: application/x-www-form-urlencoded' \
        --data-urlencode 'skillName=LuxuryStores' \
        --data-urlencode 'skillId=Id=LuxuryStores'"
    eval "$hbs"
    eval "$tbyb"
    eval "$lux"
}

# Clear all agent skills on the local data proxy.
clearAgentSkills() {
    command="curl -k --location --request POST 'https://${AC3_RC_HOST:-localhost}:32323/clear-agent-skill' \
--header 'Accept: application/json'"
    echo "$command"; eval "$command"
}

# Local App Bundle calls the local data proxy.
# Assign only when unset. .zshenv sources secrets.zsh before .zshrc loads this
# file, so a plain export would clobber your per-host value.
: "${CSC_UI_LOCAL_DATA_PROXY:=https://localhost:32323}"
export CSC_UI_LOCAL_DATA_PROXY

