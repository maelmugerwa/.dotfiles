# secrets.zsh.example - template for machine-local secrets.
#
# .zshenv and the installer both copy this to secrets.zsh on first run.
# secrets.zsh is GITIGNORED and chmod 600. Put REAL values there only.
# NEVER put a real secret, token or corp hostname in this example file.

# Quip API token - used by taskei-*-autopilot (crons, spawned subagents).
# Generate at https://quip-amazon.com/dev/token
# export QUIP_API_TOKEN=""

# AC3 dev hosts. The ac3_zsh helper functions read these.
# ac3_zsh is opt-in: rename it to ac3.zsh to load it.
# Set your own dev host. Each one defaults to localhost when unset.
# export AC3_RC_HOST=""
# export AC3_TEST_HOST=""

# Redfort/Odin cert material-set and local data proxy, for AC3 local dev.
# Setting the proxy here overrides the localhost default in ac3_zsh.
# export CSC_UI_ODIN_MATERIAL_SET=""
# export CSC_UI_LOCAL_DATA_PROXY=""
