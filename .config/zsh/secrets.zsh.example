# secrets.zsh.example - template for machine-local secrets.
#
# Shell startup (and the installer) copies this to secrets.zsh, which is
# GITIGNORED and chmod 600. Put REAL values in secrets.zsh only.
# NEVER put a real secret, token, or corp hostname in this example file.

# Quip API token - used by taskei-*-autopilot (crons, spawned subagents).
# Generate at https://quip-amazon.com/dev/token
# export QUIP_API_TOKEN=""

# AC3 / cloud-desktop dev hosts - used by ~/.config/zsh/ac3_zsh helper functions.
# Set to your own dev/test host; unset defaults to localhost.
# export AC3_RC_HOST=""
# export AC3_TEST_HOST=""

# Redfort/Odin cert material-set + local data proxy (cloud-desktop AC3 local dev).
# export CSC_UI_ODIN_MATERIAL_SET=""
# export CSC_UI_LOCAL_DATA_PROXY=""
