# Packages installed by `brew bundle`.

# Core development tools
brew "gcc"                        # GNU compiler collection. Commands: gcc, g++
brew "git"
brew "gh"                         # GitHub CLI
brew "yadm"                       # Dotfiles manager

# Shell and terminal enhancements
brew "zsh"
brew "zsh-completions"            # Extra completions. zsh auto-loads them.
brew "zsh-autosuggestions"        # Autosuggestions. .zshrc loads it.
brew "zsh-syntax-highlighting"    # Syntax highlighting. .zshrc loads it.
brew "zsh-history-substring-search" # History search on the up and down arrows
brew "starship"                   # Cross-shell prompt. Run: starship init
brew "fzf"                        # Fuzzy finder for files
brew "thefuck"                    # Corrects a mistyped command. Run: thefuck COMMAND
brew "direnv"                     # Per-directory environment switcher. Run: direnv allow
# brew "atuin"                    # mcfly covers shell history
brew "mcfly"                      # Shell history search with context
brew "zoxide"                     # Smarter cd. Use: z directory

# Modern CLI replacements
brew "bat"                        # Cat with syntax highlighting
brew "eza"                        # Replaces ls. Commands: eza, and the ls alias
brew "fd"                         # Faster find
brew "ripgrep"                    # Faster grep. Command: rg
brew "difftastic"                 # Structural diff that reads syntax. Command: difft
brew "git-delta"                  # Syntax-highlighting git pager. Command: delta

# Terminal UI tools
brew "lazygit"                    # Terminal UI for git
brew "lazydocker"                 # Terminal UI for docker
brew "btop"                       # Resource monitor
brew "neovim"                     # Vim-based editor. Command: nvim

# Data processing tools
brew "jq"                         # JSON processor
brew "httpie"                     # HTTP client. Command: http

# Development environment managers
# mise manages node, python and go in one tool, with one config.
# Versions live in ~/.config/mise/config.toml (tracked).
brew "mise"

# Containers and local models
brew "docker"
brew "colima"                     # Docker runtime without Docker Desktop
brew "ollama"                     # Runs LLMs locally

# Utilities
brew "just"                       # Command runner

# xclip needs X11. macOS uses pbcopy instead.
if OS.linux?
  brew "xclip"                    # X11 clipboard. Read with: xclip -o
end

# Homebrew on Linux has no cask support. An unguarded cask line fails
# `brew bundle` and aborts the whole bootstrap.
if OS.mac?
  # Editors and AI coding agents
  cask "visual-studio-code"       # Code editor. Command: code
  cask "claude-code"              # Terminal AI coding assistant. Command: claude
  cask "codex"                    # OpenAI terminal coding agent

  # Window, keyboard, and menu-bar control
  cask "rectangle"                # Snaps windows with keyboard shortcuts
  cask "karabiner-elements"       # Remaps the keyboard
  cask "bettertouchtool"          # Customises trackpad and input gestures
  cask "bartender"                # Manages menu-bar icons
  cask "alfred"                   # Launcher and clipboard history
  cask "domzilla-caffeine"        # Keeps the system awake

  # Apps
  cask "ticktick"                 # Task manager
  cask "spotify"                  # Music player
  cask "finicky"                  # Routes links to a chosen browser
end
